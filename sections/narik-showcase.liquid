<section class="section" id="narik"><div class="wrap">
  <div class="narik-box">
    <div class="center">
      <div class="narik-mark"><span class="brace">{</span> <span class="en">N</span> <span class="brace">}</span></div>
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Narik Edition' }}</span>
      <h2>{{ section.settings.heading | default: 'Enterprise-grade data engineering.' }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="lead" style="margin:14px auto 0;max-width:640px">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="narik-grid">
      <div class="narik-card"><h3>Dual-Engine Architecture</h3><p>Two engines in one &mdash; in-memory speed or database scale, auto-selected.</p></div>
      <div class="narik-card"><h3>Built for Gigabytes</h3><p>Opens multi-GB files with hundreds of millions of rows, effortlessly.</p></div>
      <div class="narik-card"><h3>Rust-Powered Core</h3><p>Native Rust engine for streaming ingest and native-speed queries.</p></div>
      <div class="narik-card"><h3>Every Format, One App</h3><p>JSON, NDJSON, XML, YAML, CSV, TSV &amp; delimited &mdash; all instantly explorable.</p></div>
      <div class="narik-card"><h3>One-Click Conversion</h3><p>Convert freely across JSON, CSV, XML &amp; YAML in a single click.</p></div>
      <div class="narik-card"><h3>Spreadsheet-Grade Tables</h3><p>Pin, filter, sort &amp; profile millions of rows like a spreadsheet.</p></div>
      <div class="narik-card"><h3>Lightning Search</h3><p>Trigram-indexed search finds any key or value in milliseconds.</p></div>
      <div class="narik-card"><h3>Built-In jq Filtering</h3><p>Run full jq transforms in-app &mdash; results open in a new tab.</p></div>
      <div class="narik-card"><h3>Integrated API Workbench</h3><p>Postman-style requests; explore live responses as structured data.</p></div>
      <div class="narik-card"><h3>Schema, Diff &amp; Insight</h3><p>Generate schemas, validate, diff files &amp; drill into structure.</p></div>
    </div>

    <div class="center" style="margin-top:42px">
      <a href="{{ section.settings.button_url | default: pages.contact.url | default: '/pages/contact' }}" class="btn btn--lg btn--narik">{{ section.settings.button_label | default: 'Get Narik Edition' }}</a>
    </div>
  </div>
</div></section>

{% schema %}
{
  "name": "Narik showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Narik Edition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enterprise-grade data engineering." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The flagship edition — a dual-engine, Rust-powered workbench built for the largest datasets and the most demanding teams." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Narik Edition" },
    { "type": "url", "id": "button_url", "label": "Button URL (link to the Narik product)" }
  ],
  "presets": [{ "name": "Narik showcase" }]
}
{% endschema %}
