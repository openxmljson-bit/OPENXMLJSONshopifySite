<section class="section"><div class="wrap">
  <div class="center">
    {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}<p class="lead" style="margin:14px auto 0;max-width:640px">{{ section.settings.subheading }}</p>{% endif %}
  </div>

  <div class="tut-tabs tut-tabs--blue" data-tut-tabs>
    <div class="tut-tabbar" role="tablist">
      <button type="button" class="tut-tab is-active" data-tab="narik" role="tab">{{ section.settings.tab1_label | default: 'NARIKJSON' }}</button>
      <button type="button" class="tut-tab" data-tab="open" role="tab">{{ section.settings.tab2_label | default: 'OPENXMLJSON' }}</button>
    </div>

    <div class="tut-list">
      {%- assign n_open = 0 -%}{%- assign n_narik = 0 -%}
      {% for block in section.blocks %}
        {%- if block.settings.tab == 'narik' -%}{%- assign n_narik = n_narik | plus: 1 -%}{%- assign num = n_narik -%}{%- else -%}{%- assign n_open = n_open | plus: 1 -%}{%- assign num = n_open -%}{%- endif -%}
        {%- assign r = num | modulo: 2 -%}
        <div class="tut-step {% if r == 0 %}tut-step--rev{% endif %}" data-tab="{{ block.settings.tab | default: 'open' }}"{% unless block.settings.tab == 'narik' %} hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="tut-shot">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1600">
            {% else %}
              <div class="tut-shot__ph">Screenshot {{ num }} &mdash; upload in the theme editor</div>
            {% endif %}
          </div>
          <div class="tut-text">
            <div class="tut-num">{{ num }}</div>
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.caption != blank %}<p>{{ block.settings.caption }}</p>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div></section>

<script>
  (function(){
    var root = document.querySelector('[data-tut-tabs]');
    if (!root) return;
    var tabs = root.querySelectorAll('.tut-tab');
    var steps = root.querySelectorAll('.tut-step');
    function show(tab){
      root.classList.toggle('tut-tabs--blue', tab === 'narik');
      for (var i=0;i<tabs.length;i++){ tabs[i].classList.toggle('is-active', tabs[i].getAttribute('data-tab')===tab); }
      var n=0;
      for (var j=0;j<steps.length;j++){
        var s=steps[j];
        if (s.getAttribute('data-tab')===tab){
          s.hidden=false; n++;
          var num=s.querySelector('.tut-num'); if(num) num.textContent=n;
          s.classList.toggle('tut-step--rev', n % 2 === 0);
        } else { s.hidden=true; }
      }
    }
    for (var k=0;k<tabs.length;k++){ (function(t){ t.addEventListener('click', function(){ show(t.getAttribute('data-tab')); }); })(tabs[k]); }
    show(tabs[0].getAttribute('data-tab'));
  })();
</script>

{% schema %}
{
  "name": "Tutorial tabs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Tutorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn the apps, step by step." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick a product and follow the annotated, step-by-step walkthrough." },
    { "type": "text", "id": "tab1_label", "label": "Tab 1 label", "default": "NARIKJSON" },
    { "type": "text", "id": "tab2_label", "label": "Tab 2 label", "default": "OPENXMLJSON" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "select", "id": "tab", "label": "Show under tab", "default": "open", "options": [ { "value": "open", "label": "OPENXMLJSON" }, { "value": "narik", "label": "NARIKJSON" } ] },
        { "type": "image_picker", "id": "image", "label": "Screenshot (annotate before uploading)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "textarea", "id": "caption", "label": "Caption", "default": "Describe what the user should do or notice in this screenshot." }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [{ "name": "Tutorial tabs" }]
}
{% endschema %}
