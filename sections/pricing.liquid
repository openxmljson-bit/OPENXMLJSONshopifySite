<section class="section" id="pricing">
  <div class="wrap">
    <div class="center" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p class="lead">{{ section.settings.subheading }}</p>
    </div>
    {%- comment -%}
      The grid follows the number of plans: with fewer than three the default
      three-column track would leave an empty column and shove the cards left.
    {%- endcomment -%}
    {%- assign has_groups = false -%}
    {%- assign plan_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}{%- assign has_groups = true -%}
      {%- else -%}{%- assign plan_count = plan_count | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    <div class="plans {% if has_groups %}plans--grouped{% else %}plans--n{{ plan_count }}{% endif %}" data-stagger="90">
      {% for block in section.blocks %}
        {% if block.type == 'group' %}
          <div class="plan-group" {{ block.shopify_attributes }}>
            <span class="plan-group__label">{{ block.settings.label }}</span>
            <span class="plan-group__line"></span>
          </div>
        {% else %}
        <div class="plan {% if block.settings.featured %}featured{% endif %}{% if block.settings.dark %} plan--dark{% endif %}" {{ block.shopify_attributes }}>
          <div>
            <div class="plan__name">{{ block.settings.name }}</div>
            {% if block.settings.edition_label != blank %}
              <span class="plan__badge" style="background:{{ block.settings.badge_color }}22;color:{{ block.settings.badge_color }};margin-top:8px">{{ block.settings.edition_label }}</span>
            {% endif %}
          </div>
          <div class="plan__price">{% if block.settings.original_price != blank %}<span class="plan__was">{{ block.settings.original_price }}</span>{% endif %}{{ block.settings.price }}<small>{{ block.settings.price_note }}</small></div>
          <p class="plan__desc">{{ block.settings.desc }}</p>
          <ul>
            {% assign feats = block.settings.features | newline_to_br | split: '<br />' %}
            {% for f in feats %}
              {% assign ft = f | strip %}
              {% if ft != blank %}
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>
                  <span>{{ ft }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
          <a href="{{ block.settings.button_url }}" class="btn {% if block.settings.featured %}btn--primary{% else %}btn--ghost{% endif %} btn--block">{{ block.settings.button_label }}</a>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editions / pricing",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your NARIKJSON plan." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Free monthly or a yearly license — it's the same complete app either way. The yearly license adds volume licensing, managed deployment and a support SLA." }
  ],
  "blocks": [
    { "type": "group", "name": "Product heading", "settings": [
      { "type": "text", "id": "label", "label": "Product name", "default": "NARIKJSON" }
    ]},
    { "type": "plan", "name": "Plan", "settings": [
      { "type": "text", "id": "name", "label": "Name", "default": "Plan" },
      { "type": "text", "id": "edition_label", "label": "Edition badge" },
      { "type": "color", "id": "badge_color", "label": "Badge color", "default": "#4c9df7" },
      { "type": "text", "id": "price", "label": "Price", "default": "$0" },
      { "type": "text", "id": "original_price", "label": "Original price (strikethrough)" },
      { "type": "text", "id": "price_note", "label": "Price note" },
      { "type": "textarea", "id": "desc", "label": "Description" },
      { "type": "textarea", "id": "features", "label": "Features (one per line)" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Get started" },
      { "type": "url", "id": "button_url", "label": "Button URL" },
      { "type": "checkbox", "id": "featured", "label": "Highlight as popular", "default": false },
      { "type": "checkbox", "id": "dark", "label": "Dark (NARIKJSON) styling", "default": true }
    ]}
  ],
  "presets": [{
    "name": "Editions / pricing",
    "blocks": [
      { "type": "plan", "settings": {
        "name": "NARIKJSON Free", "edition_label": "Free monthly", "badge_color": "#4C9DF7",
        "original_price": "$20", "price": "FREE",
        "desc": "The complete dual-engine workbench — no file-size limit.",
        "features": "Dual-engine architecture (in-memory + database)\nMulti-GB files, 100M+ rows\nRust-powered native core\nEvery format — JSON, NDJSON, XML, YAML, CSV, TSV\nOne-click conversion between formats\nSpreadsheet-grade tables & SQL console\nTrigram-indexed lightning search\nBuilt-in jq filtering\nIntegrated API workbench\nSchema generation, validation & diff",
        "button_label": "Download free", "featured": false, "dark": true } },
      { "type": "plan", "settings": {
        "name": "NARIKJSON", "edition_label": "Paid yearly", "badge_color": "#4C9DF7",
        "original_price": "$199", "price": "$99", "price_note": " / year",
        "desc": "Everything in Free, plus licensing, deployment and support for teams.",
        "features": "Dual-engine architecture (in-memory + database)\nMulti-GB files, 100M+ rows\nRust-powered native core\nEvery format — JSON, NDJSON, XML, YAML, CSV, TSV\nOne-click conversion between formats\nSpreadsheet-grade tables & SQL console\nTrigram-indexed lightning search\nBuilt-in jq filtering\nIntegrated API workbench\nSchema generation, validation & diff",
        "button_label": "Get NARIKJSON", "featured": true, "dark": true } }
    ]
  }]
}
{% endschema %}
